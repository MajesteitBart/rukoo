{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rukoo Voice",
  "mainBinaryName": "rukoo-voice",
  "identifier": "nl.bvdm.rukoo.voice",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bart van der Meeren",
    "copyright": "Copyright (c) 2026 Bart van der Meeren",
    "homepage": "https://github.com/MajesteitBart/rukoo",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Push-to-talk dictation and a meeting recorder for Rukoo",
    "longDescription": "Rukoo Voice types what you say into any app and records your meetings for Rukoo, with transcription on your own computer or with the provider you choose.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "languages": ["English", "Dutch"],
        "customLanguageFiles": {
          "English": "nsis/English.nsh",
          "Dutch": "nsis/Dutch.nsh"
        },
        "displayLanguageSelector": false
      }
    }
  }
}
