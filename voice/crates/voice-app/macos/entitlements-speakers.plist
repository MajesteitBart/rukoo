<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The speaker worker loads the NeMo dylibs with dlopen. They are ad-hoc signed like the worker itself, and
	     hardened runtime's library validation refuses code with another Team ID, so this worker alone gets this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
