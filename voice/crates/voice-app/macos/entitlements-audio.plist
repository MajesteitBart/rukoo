<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The microphone. With hardened runtime a program needs this or macOS refuses the input device.
	     No App Sandbox: Voice posts keys into other apps and starts its helpers detached. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
