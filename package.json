{
  "name": "rukoo-mail",
  "version": "2.2.0",
  "description": "Rukoo Mail: an email client for Windows, macOS and Linux, built with Electron",
  "main": "src/main/main.js",
  "rukoo": {
    "accountServer": "https://rukoo.io",
    "releases": "MajesteitBart/rukoo"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "playwright test",
    "i18n:check": "node --test test/i18n.test.js",
    "screenshots": "node scripts/screenshots.js docs/screenshots",
    "icon": "node scripts/start-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "author": "Bart van der Meeren",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11",
    "hash-wasm": "^4.12.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "ical.js": "^2.2.1",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.2.6",
    "libqp": "^2.1.2",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "Rukoo Mail",
  "private": true,
  "build": {
    "appId": "nl.bvdm.rukoo-mail",
    "productName": "Rukoo Mail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "skills/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/MajesteitBart/rukoo/releases/latest/download"
    },
    "detectUpdateChannel": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Rukoo-Mail-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Rukoo-Mail-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "rukoo-mail",
      "category": "Network;Email",
      "mimeTypes": [
        "x-scheme-handler/mailto",
        "text/calendar"
      ],
      "maintainer": "Bart van der Meeren <MajesteitBart@users.noreply.github.com>",
      "artifactName": "Rukoo-Mail-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Rukoo-Mail-${version}-mac-${arch}.${ext}",
      "protocols": [
        {
          "name": "Email links",
          "schemes": [
            "mailto"
          ],
          "role": "Viewer"
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Rukoo Mail uses the local network only for things you set up: a mail or calendar server on your own network, or remote agent access, which connects Rukoo with an agent or your phone on another device. If you use neither, Rukoo works without this access."
      },
      "extraResources": [
        {
          "from": "build/mac/nl.lproj",
          "to": "nl.lproj"
        }
      ],
      "hardenedRuntime": true,
      "fileAssociations": [
        {
          "ext": "ics",
          "name": "Calendar file",
          "role": "Viewer",
          "mimeType": "text/calendar"
        }
      ]
    }
  },
  "homepage": "https://github.com/MajesteitBart/rukoo",
  "desktopName": "rukoo-mail.desktop"
}
