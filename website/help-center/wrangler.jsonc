// help.rukoo.io on Cloudflare: the built help center from dist/, served as static assets by its own Worker.
// It shares nothing with the rukoo-site Worker for rukoo.io. Build first (npm run build), then deploy with
// `npx wrangler@4 deploy` (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID, or wrangler login).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "rukoo-help",
  "compatibility_date": "2026-10-20",

  // No Worker script: Cloudflare answers from the files in dist/. Astro writes /page/index.html, so /page and /page/
  // both reach it, and a missing path gets dist/404.html with a 404 status.
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },

  "routes": [{ "pattern": "help.rukoo.io", "custom_domain": true }],
  "workers_dev": false,

  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
