// Cloudflare settings for the Rukoo account server. README.md explains each step of deploying your own copy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rukoo-account",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  // The booking pages' font files (src/fonts.js) and icons (src/icons.js), bundled as binary data.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2", "**/*.ico", "**/*.png", "**/*.svg"] }],

  // One Durable Object per account, each with its own SQLite database.
  // REGISTRY: one object for the whole server that counts the accounts, for MAX_ACCOUNTS.
  // BOOKINGS: one object per booking page handle, holding what the page published and its bookings.
  // WORKSPACES: one object per team workspace, holding its members, channels and messages (WORKSPACES.md).
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "Account" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "BOOKINGS", "class_name": "Booking" },
      { "name": "WORKSPACES", "class_name": "Workspace" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] },
    { "tag": "v3", "new_sqlite_classes": ["Booking"] },
    { "tag": "v4", "new_sqlite_classes": ["Workspace"] }
  ],

  "vars": {
    // Who runs this server, shown by GET /v1/info, in the app before sign-up, and on the page at /.
    "OPERATOR_NAME": "",
    "OPERATOR_URL": "",
    "OPERATOR_CONTACT": "",
    "PRIVACY_URL": "",
    // Where accounts are stored: "eu", "us", "fedramp" or "" for anywhere. Choose before the first sign-up and never
    // change it afterwards: every account would seem to vanish, because objects are found per jurisdiction.
    "JURISDICTION": "eu",
    // "open", "invite" (codes from the INVITE_CODES secret) or "closed".
    "SIGNUPS": "invite",
    // How many accounts each invite code may make; 0 for any number.
    "INVITE_USES": 1,
    // Per account: live records, and their total size in bytes.
    "MAX_RECORDS": 250000,
    "MAX_BYTES": 104857600,
    // The most accounts this server holds; 0 for no cap. With open sign-ups this bounds what strangers can store:
    // at most MAX_ACCOUNTS times MAX_BYTES.
    "MAX_ACCOUNTS": 1000,
    // Booking pages: hours after the last publish when every meeting type needs the host's confirmation, and days
    // after which a page offers no times at all.
    "BOOKING_STALE_HOURS": 24,
    "BOOKING_DARK_DAYS": 7,
    // An address booking pages live at the root of, such as "https://meet.example/<handle>", routed to this Worker as
    // well; /meet on any other address redirects there. "" keeps them under /meet on the address each request came in
    // on.
    "BOOKING_ORIGIN": "",
    // Addresses booking pages used to live at, comma-separated origins: MCP takes their /meet/<handle> links as the
    // same pages.
    "BOOKING_ALIASES": "",
    // Addresses whose root held the booking pages before BOOKING_ORIGIN, comma-separated origins: their paths redirect
    // to BOOKING_ORIGIN (apart from /, /privacy and the account API), and links to them name the same pages.
    "BOOKING_FORMER_ROOTS": "",
    // Handles taken down by the operator, comma-separated: they answer 404 and can't be claimed.
    "BLOCKED_HANDLES": "",
    // Team chat (WORKSPACES.md): "on" or "off". Whoever runs this server can read a workspace's messages, unlike the
    // records accounts sync. Deploy with "off" first, and turn it on in a second deploy, once every address of this
    // server runs this version: an older version would wipe a deleted account before its workspaces heard of it.
    "WORKSPACE_MODE": "off",
    // The one address workspaces on this server are known by, such as "https://rukoo.example". "" for the address
    // each request came in on.
    "WORKSPACE_ORIGIN": "",
    // "on" or "off". With SIGNUPS on "invite" and team chat on, "on" lets an invitation into a workspace stand in for
    // an invite code at sign-up, once per invitation. That lets every workspace owner and admin bring new accounts
    // onto this server, within MAX_ACCOUNTS. "off" keeps sign-ups to the codes in INVITE_CODES.
    "WORKSPACE_SIGNUPS": "on",
    // The most workspaces this server holds, how many one account may make, and how many it may be in at once.
    "MAX_WORKSPACES": 100,
    "MAX_WORKSPACES_PER_ACCOUNT": 3,
    "MAX_WORKSPACE_MEMBERSHIPS": 50,
    // Per workspace: members, open connections, channels, bytes of message text kept, and days a message is kept.
    // A workspace is one Durable Object, which holds 10 GB on Workers Paid and 1 GB on Workers Free, and a message
    // takes about 100 bytes on top of its text: lower WORKSPACE_BYTES to 268435456 on Workers Free.
    "WORKSPACE_MEMBERS": 100,
    "WORKSPACE_SOCKETS": 200,
    "WORKSPACE_CONVERSATIONS": 8192,
    "WORKSPACE_BYTES": 1073741824,
    "WORKSPACE_RETENTION_DAYS": 90,
    // Files in team chat, once the WORKSPACE_FILES bucket below is bound: the largest file in bytes (25 MiB), and the
    // bytes of files one workspace may keep, stored and reserved together (5 GiB). These are counted apart from
    // WORKSPACE_BYTES, which stays message text only.
    "WORKSPACE_FILE_BYTES": 26214400,
    "WORKSPACE_FILES_BYTES": 5368709120,
    // "on" or "off": whether the server makes link cards for addresses in messages. It fetches those pages itself,
    // so the linked sites see this server and never a member's own address.
    "WORKSPACE_PREVIEWS": "on",
    // An address of its own for upload and download links, such as "https://files.rukoo.example", routed to this
    // Worker as well. "" for the workspace's own address.
    "WORKSPACE_FILES_ORIGIN": "",
    // For tests only: host:port pairs, comma-separated, that link cards may fetch although they are local. Leave empty.
    "WORKSPACE_PREVIEW_HOSTS": "",
    // Files in a bucket of an S3-compatible service instead of R2 (README.md, "Files in an S3-compatible bucket"): the
    // service's https address without the bucket, the region it signs with, and the bucket's name, all three or none.
    // The access key goes in two Worker secrets, WORKSPACE_FILES_S3_ACCESS_KEY_ID and
    // WORKSPACE_FILES_S3_SECRET_ACCESS_KEY, never here. The WORKSPACE_FILES binding below wins when both are set.
    "WORKSPACE_FILES_S3_ENDPOINT": "",
    "WORKSPACE_FILES_S3_REGION": "",
    "WORKSPACE_FILES_S3_BUCKET": "",
    // Who keeps the files of an S3 store and where, as /privacy names them: the company or service, such as "UpCloud",
    // and the place, such as "Frankfurt am Main". With either one empty, /privacy names neither and calls it the
    // S3-compatible service this server uses. They don't turn files on or off.
    "WORKSPACE_FILES_S3_PROVIDER": "",
    "WORKSPACE_FILES_S3_PLACE": "",
    // "on" when Rukoo's website runs in front of this server with Rukoo in the browser at /app/ (website/), as on
    // rukoo.io. The privacy statement then covers what the browser keeps. "off" for a server on its own.
    "WEB_APP": "off"
  },

  // Files in team chat live in a private R2 bucket, or in the S3-compatible bucket the WORKSPACE_FILES_S3_* settings
  // name. With neither, the server offers no files, and every file route answers 403 files_off. To turn R2 files on,
  // make a bucket in the jurisdiction JURISDICTION names and remove the comment marks below, keeping "jurisdiction"
  // equal to it ("eu" here; leave the field out for a bucket without one):
  //   npx wrangler r2 bucket create rukoo-workspace-files --jurisdiction eu
  // The bucket stays private, with no public access: devices upload and download through this Worker, with links it
  // signs.
  // "r2_buckets": [{ "binding": "WORKSPACE_FILES", "bucket_name": "rukoo-workspace-files", "jurisdiction": "eu" }],

  // Limits prelogin, signup, login and recovery to 30 requests a minute per client address in each Cloudflare
  // location. namespace_id is any number of your choosing that no other rate limiter in your account uses. Remove
  // this block to turn the limit off; the account lock after ten wrong passwords still applies.
  // PUSH_LIMITER does the same for writing records, at 120 pushes a minute, which a device that syncs never reaches.
  // BOOKING_LIMITER limits every public write on booking pages (bookings, cancellations, reschedules) to 20 a minute.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUSH_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "BOOKING_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],

  // Keeps the server's own error messages in Workers Logs but not a log line per request, which would hold every
  // request's address and metadata.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  // The server Rukoo itself uses, run by its maintainer: npm run deploy -- --env bvdm. A fork deploys the settings
  // above with its own vars instead. Bindings and vars don't carry over into an environment, so they're repeated.
  // meet.rukoo.io is this Worker's own custom domain, for the booking pages. rukoo.io reaches it through the
  // rukoo-site Worker's ACCOUNT service binding (README.md) for the account API. rukoo-account.bvdm.ai stays for
  // devices that still sync with it and for old /meet links, which redirect to meet.rukoo.io.
  "env": {
    "bvdm": {
      "name": "rukoo-account",
      "routes": [
        { "pattern": "rukoo-account.bvdm.ai", "custom_domain": true },
        { "pattern": "meet.rukoo.io", "custom_domain": true }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ACCOUNTS", "class_name": "Account" },
          { "name": "REGISTRY", "class_name": "Registry" },
          { "name": "BOOKINGS", "class_name": "Booking" },
          { "name": "WORKSPACES", "class_name": "Workspace" }
        ]
      },
      "vars": {
        "OPERATOR_NAME": "Bart van der Meeren",
        "OPERATOR_URL": "https://bvdm.ai",
        "OPERATOR_CONTACT": "https://bvdm.ai/nl/contact",
        "PRIVACY_URL": "",
        "JURISDICTION": "eu",
        // Invite codes until sign-ups check the address (#121): with open sign-ups, invented addresses could fill
        // MAX_ACCOUNTS and keep everyone else out.
        "SIGNUPS": "invite",
        "INVITE_USES": 1,
        "MAX_RECORDS": 250000,
        // 1,000 accounts of at most 32 MiB keep the worst case at 32 GB.
        "MAX_BYTES": 33554432,
        "MAX_ACCOUNTS": 1000,
        "BOOKING_STALE_HOURS": 24,
        "BOOKING_DARK_DAYS": 7,
        // Booking pages, /mcp and /llms.txt live at the root of meet.rukoo.io.
        "BOOKING_ORIGIN": "https://meet.rukoo.io",
        // Where the pages lived before: /meet on the old address, and the root of rukoo.io. Both redirect, and MCP takes
        // their links as the same pages.
        "BOOKING_ALIASES": "https://rukoo-account.bvdm.ai",
        "BOOKING_FORMER_ROOTS": "https://rukoo.io",
        "BLOCKED_HANDLES": "",
        // Team chat is on here: the desktop app and Rukoo for Android have Chat, and /privacy covers it.
        "WORKSPACE_MODE": "on",
        "WORKSPACE_ORIGIN": "https://rukoo.io",
        // Lets every workspace owner and admin bring new accounts onto this server with an invitation, within
        // MAX_ACCOUNTS (docs/workspace-architecture.md).
        "WORKSPACE_SIGNUPS": "on",
        "MAX_WORKSPACES": 100,
        "MAX_WORKSPACES_PER_ACCOUNT": 3,
        "MAX_WORKSPACE_MEMBERSHIPS": 50,
        "WORKSPACE_MEMBERS": 100,
        "WORKSPACE_SOCKETS": 200,
        "WORKSPACE_CONVERSATIONS": 8192,
        "WORKSPACE_BYTES": 1073741824,
        "WORKSPACE_RETENTION_DAYS": 90,
        // Files in team chat live in UpCloud Managed Object Storage in Frankfurt, path-style. The access key is two
        // Worker secrets: npx wrangler secret put WORKSPACE_FILES_S3_ACCESS_KEY_ID --env bvdm, and the same for
        // WORKSPACE_FILES_S3_SECRET_ACCESS_KEY. Until both are set, files stay off and the Worker logs which is
        // missing; node scripts/s3-live-check.mjs checks the bucket and key first. These limits apply from then on.
        "WORKSPACE_FILE_BYTES": 26214400,
        "WORKSPACE_FILES_BYTES": 5368709120,
        "WORKSPACE_PREVIEWS": "on",
        "WORKSPACE_FILES_ORIGIN": "",
        "WORKSPACE_PREVIEW_HOSTS": "",
        "WORKSPACE_FILES_S3_ENDPOINT": "https://lqmo4.upcloudobjects.com",
        "WORKSPACE_FILES_S3_REGION": "europe-2",
        "WORKSPACE_FILES_S3_BUCKET": "rukoo-workspace-files",
        // Who keeps the files and where, as /privacy names them: UpCloud Ltd, a Finnish company, in its Frankfurt am Main
        // data centre (europe-2).
        "WORKSPACE_FILES_S3_PROVIDER": "UpCloud",
        "WORKSPACE_FILES_S3_PLACE": "Frankfurt am Main",
        // The website in front of this server runs team chat in the browser at rukoo.io/app/.
        "WEB_APP": "on"
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "PUSH_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "BOOKING_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
