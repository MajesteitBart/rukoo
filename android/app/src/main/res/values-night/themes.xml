<?xml version="1.0" encoding="utf-8"?>
<!-- The window before Compose draws, in dark mode. -->
<resources>
    <style name="Theme.Rukoo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rukoo_bg_dark</item>
        <item name="android:colorBackground">@color/rukoo_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/rukoo_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rukoo_launcher_background</item>
    </style>
</resources>
