<resources>
    <string name="categories_presets_needs_you_name">Actie nodig</string>
    <string name="categories_presets_needs_you_description">Mail van mensen die iets van je vraagt: antwoorden, beslissen, goedkeuren, tekenen, betalen of komen.</string>
    <string name="categories_presets_to_read_name">Lezen</string>
    <string name="categories_presets_to_read_description">Mail van mensen of organisaties die het lezen waard is maar niets van je vraagt: nieuws van collega\'s, gesprekken waarin je in de cc staat, persoonlijke updates.</string>
    <string name="categories_presets_money_name">Geldzaken</string>
    <string name="categories_presets_money_description">Facturen, betaalverzoeken, bonnetjes, orderbevestigingen, mail van de bank en de belastingdienst, abonnementen en terugbetalingen.</string>
    <string name="categories_presets_updates_name">Updates</string>
    <string name="categories_presets_updates_description">Automatische meldingen: bezorging, account- en beveiligingsmeldingen, reacties en vermeldingen in apps, sociale netwerken en forums.</string>
    <string name="categories_presets_promotions_name">Reclame</string>
    <string name="categories_presets_promotions_description">Nieuwsbrieven, marketing, aanbiedingen en kortingen, en evenementen of webinars die iemand verkoopt.</string>
