    <string name="settings_categories_jev_error_key">TypeSafe accepteerde de API-sleutel niet. Controleer hem of zet Jev uit.</string>
    <string name="settings_categories_jev_error_busy">TypeSafe heeft het druk. Rukoo probeert het over een paar minuten opnieuw en sorteert intussen op regels.</string>
    <string name="settings_categories_jev_error_network">Kan TypeSafe niet bereiken. Rukoo probeert het over een paar minuten opnieuw en sorteert intussen op regels.</string>
    <string name="settings_categories_again">De inbox opnieuw sorteren</string>
