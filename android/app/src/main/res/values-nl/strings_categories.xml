    <string name="settings_categories_on_help">De inbox krijgt tabbladen, zoals Actie nodig en Reclame. Er verplaatst of verandert niets op je mailserver, en andere mailapps zien je inbox zoals altijd.</string>
    <string name="settings_categories_list">Categorieën</string>
    <string name="settings_categories_list_help">Elke e-mail komt in één categorie. Als er meer passen, wint de bovenste.</string>
